@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Primary">
        <MudIcon Icon="@Icons.Material.Filled.ShowChart" Class="me-3" />
        <MudText Typo="Typo.h5">RheoSense Trends</MudText>
        <MudSpacer />
        <MudText Typo="Typo.body2">Active pit and return flow</MudText>
    </MudAppBar>
<MudMainContent Style="padding: 76px 12px 12px;">
        <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>
