@using System.Globalization

<MudPaper Class="pa-3 mb-3" Elevation="1">
    <MudText Typo="Typo.subtitle1">@Title</MudText>
    <MudText Typo="Typo.caption" Color="Color.Secondary">@UnitLabel</MudText>
    <svg class="trend-chart" viewBox="0 0 1000 220" role="img" aria-label="@Title">
        @foreach (double fraction in TickFractions)
        {
            double y = PlotTop + fraction * PlotHeight;
            <line class="chart-grid" x1="@PlotLeft" y1="@y" x2="@(PlotLeft + PlotWidth)" y2="@y" />
            @SvgText(PlotLeft - 10, y + 4, FormatValue(yMaximum - fraction * (yMaximum - yMinimum)), anchor: "end")
        }
        @foreach (double fraction in TickFractions)
        {
            double x = PlotLeft + fraction * PlotWidth;
            <line class="chart-grid" x1="@x" y1="@PlotTop" x2="@x" y2="@(PlotTop + PlotHeight)" />
            @SvgText(x, PlotTop + PlotHeight + 24, FormatTime(StartUtc + TimeSpan.FromTicks((long)((EndUtc - StartUtc).Ticks * fraction))), anchor: "middle")
        }
        <line class="chart-axis" x1="@PlotLeft" y1="@PlotTop" x2="@PlotLeft" y2="@(PlotTop + PlotHeight)" />
        <line class="chart-axis" x1="@PlotLeft" y1="@(PlotTop + PlotHeight)" x2="@(PlotLeft + PlotWidth)" y2="@(PlotTop + PlotHeight)" />

        @foreach (TrendSeries series in Series)
        {
            string points = BuildPolyline(series);
            if (!string.IsNullOrEmpty(points))
            {
                <polyline points="@points" fill="none" stroke="@series.Color" stroke-width="2.25" stroke-linejoin="round" stroke-linecap="round" />
            }
        }

        @for (int index = 0; index < Series.Count; index++)
        {
            TrendSeries series = Series[index];
            double x = PlotLeft + index * 220;
            <line x1="@x" y1="12" x2="@(x + 24)" y2="12" stroke="@series.Color" stroke-width="4" />
            @SvgText(x + 31, 16, series.Name, cssClass: "legend-label")
        }

        @if (!Series.Any(series => series.Points.Count > 0))
        {
            @SvgText(500, 108, "Waiting for Blackboard data…", anchor: "middle")
        }
    </svg>
</MudPaper>

@code {
    private const double PlotLeft = 76;
    private const double PlotTop = 30;
    private const double PlotWidth = 900;
    private const double PlotHeight = 142;
    private static readonly double[] TickFractions = { 0, 0.25, 0.5, 0.75, 1 };

    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string UnitLabel { get; set; } = string.Empty;
    [Parameter, EditorRequired] public IReadOnlyList<TrendSeries> Series { get; set; } = Array.Empty<TrendSeries>();
    [Parameter] public DateTimeOffset StartUtc { get; set; }
    [Parameter] public DateTimeOffset EndUtc { get; set; }
    [Parameter] public string DateReferenceName { get; set; } = "UTC";

    [CascadingParameter]
    private MudUnitAndReferenceChoiceTag? UnitChoice { get; set; }

    private double yMinimum;
    private double yMaximum = 1;

    protected override void OnParametersSet()
    {
        double[] values = Series.SelectMany(series => series.Points).Select(point => point.Value).Where(double.IsFinite).ToArray();
        if (values.Length == 0)
        {
            yMinimum = 0;
            yMaximum = 1;
            return;
        }

        double minimum = values.Min();
        double maximum = values.Max();
        double padding = Math.Max((maximum - minimum) * 0.1, Math.Max(Math.Abs(maximum) * 0.02, 1e-9));
        yMinimum = minimum - padding;
        yMaximum = maximum + padding;
    }

    private string BuildPolyline(TrendSeries series)
    {
        if (EndUtc <= StartUtc || yMaximum <= yMinimum)
        {
            return string.Empty;
        }

        return string.Join(' ', series.Points
            .Where(point => point.TimestampUtc >= StartUtc && point.TimestampUtc <= EndUtc && double.IsFinite(point.Value))
            .Select(point =>
            {
                double x = PlotLeft + (point.TimestampUtc - StartUtc).TotalSeconds / (EndUtc - StartUtc).TotalSeconds * PlotWidth;
                double y = PlotTop + (yMaximum - point.Value) / (yMaximum - yMinimum) * PlotHeight;
                return $"{x.ToString("F2", CultureInfo.InvariantCulture)},{y.ToString("F2", CultureInfo.InvariantCulture)}";
            }));
    }

    private static string FormatValue(double value) => value.ToString("G4", CultureInfo.InvariantCulture);
    private string FormatTime(DateTimeOffset time) =>
        UnitChoice?.FormatDateTime(time, "HH:mm") ??
        (DateReferenceName == "Local Time" ? time.ToLocalTime() : time.ToUniversalTime()).ToString("HH:mm");

    private static RenderFragment SvgText(double x, double y, string value, string? cssClass = null, string? anchor = null) => builder =>
    {
        builder.OpenElement(0, "text");
        builder.AddAttribute(1, "x", x);
        builder.AddAttribute(2, "y", y);
        if (!string.IsNullOrWhiteSpace(cssClass))
        {
            builder.AddAttribute(3, "class", cssClass);
        }
        if (!string.IsNullOrWhiteSpace(anchor))
        {
            builder.AddAttribute(4, "text-anchor", anchor);
        }
        builder.AddContent(5, value);
        builder.CloseElement();
    };
}
