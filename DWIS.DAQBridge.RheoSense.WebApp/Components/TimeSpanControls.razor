@implements IDisposable

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="2">
    <MudIconButton Icon="@Icons.Material.Filled.Remove"
                   Color="Color.Primary"
                   Variant="Variant.Filled"
                   Disabled="@(currentValue <= RheoSensePreferenceStore.MinimumHours)"
                   OnClick="Decrease"
                   aria-label="Decrease time span" />
    <MudText Typo="Typo.h6" Class="mx-3">
        Last @currentValue hour@(currentValue == 1 ? string.Empty : "s")
    </MudText>
    <MudIconButton Icon="@Icons.Material.Filled.Add"
                   Color="Color.Primary"
                   Variant="Variant.Filled"
                   Disabled="@(currentValue >= RheoSensePreferenceStore.MaximumHours)"
                   OnClick="Increase"
                   aria-label="Increase time span" />
</MudStack>

@code {
    private const int CommitDelayMilliseconds = 300;
    private CancellationTokenSource? commitCancellation;
    private int currentValue;

    [Parameter]
    public int Value { get; set; }

    [Parameter]
    public EventCallback<int> ValueChanged { get; set; }

    protected override void OnParametersSet()
    {
        if (commitCancellation is null)
        {
            currentValue = Value;
        }
    }

    private void Decrease()
    {
        currentValue = Math.Max(RheoSensePreferenceStore.MinimumHours, currentValue - 1);
        ScheduleCommit();
    }

    private void Increase()
    {
        currentValue = Math.Min(RheoSensePreferenceStore.MaximumHours, currentValue + 1);
        ScheduleCommit();
    }

    private void ScheduleCommit()
    {
        commitCancellation?.Cancel();
        commitCancellation?.Dispose();
        commitCancellation = new CancellationTokenSource();
        _ = CommitAsync(currentValue, commitCancellation.Token);
    }

    private async Task CommitAsync(int value, CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(CommitDelayMilliseconds, cancellationToken);
            await InvokeAsync(() => ValueChanged.InvokeAsync(value));
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        finally
        {
            if (!cancellationToken.IsCancellationRequested)
            {
                commitCancellation?.Dispose();
                commitCancellation = null;
            }
        }
    }

    public void Dispose()
    {
        commitCancellation?.Cancel();
        commitCancellation?.Dispose();
    }
}
